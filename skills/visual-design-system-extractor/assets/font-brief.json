{
  "brief": "Map visible type evidence onto live catalog filters. Fill every field from the reference, not from taste, then pass the values to scripts/rare_google_fonts.py discover.",
  "visual_evidence": {
    "letterforms": "",
    "stroke_contrast": "",
    "width_and_proportion": "",
    "weight_range_seen": "",
    "language_coverage_seen": "",
    "era_or_context_cues": ""
  },
  "filters": {
    "category": null,
    "subset": null,
    "search": null,
    "variable_only": false,
    "added_after": null,
