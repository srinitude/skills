      "primary_output": "proof.coverage-map",
      "decision_owner": "agent with vision evidence",
      "support_files": [
        "scripts/lib/artifact_contract.py",
        "scripts/lib/coverage.py",
        "scripts/run_pipeline.py"
      ]
