    {
      "id": "S25",
      "consumes": ["package.validation", "final.readback", "run.contract"],
      "produces": ["completion.disposition"],
      "primary_output": "completion.disposition",
      "decision_owner": "agent",
      "support_files": [
        "references/deterministic-execution.md",
        "references/evidence-schema.md",
        "scripts/run_pipeline.py"
      ]
