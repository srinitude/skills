{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lineage.schema.json",
  "title": "Design part lineage",
  "type": "object",
  "required": ["dtcg", "layers", "links"],
  "properties": {
    "dtcg": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "PASS" } }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["atom", "molecule", "organism", "template", "page"] },
          "status": { "enum": ["PASS", "STALE", "BLOCKED"] }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
