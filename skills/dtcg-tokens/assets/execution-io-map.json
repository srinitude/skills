      "support_files": [
        "references/validation.md",
        "references/file-trigger-audit.md",
        "evals/contract.md",
        "evals/rubric.md",
        "scripts/validate_skill.py",
        "scripts/audit_file_triggers.py",
        "scripts/check_evals.py",
