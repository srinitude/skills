{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-intake.schema.json",
  "title": "Design run intake",
  "type": "object",
  "required": [
    "outcome",
    "audience",
    "platform",
    "primary_tasks",
    "source_permissions",
    "proof_threshold"
  ],
  "properties": {
    "outcome": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "primary_tasks": { "type": "array", "minItems": 1 },
    "source_permissions": { "type": "array", "minItems": 1 },
    "proof_threshold": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
