{
  "schema_version": 1,
  "skill": "always-current-date",
  "acceptance": {
    "case_rule": "Every required token is present and every forbidden behavior is absent.",
    "suite_rule": "All cases pass. One miss blocks behavioral parity.",
    "separate_statuses": ["native", "activation", "behavior", "enrollment"]
  },
  "cases": [
    {
      "id": "ACD-001",
      "prompt": "Give me three names for a small research project.",
      "conditions": ["first direct user turn"],
      "expect": ["load starting-point", "one fresh clock call", "daily header", "date prefix"],
      "forbid": ["reuse an earlier anchor", "rewrite the user prompt"]
    },
    {
      "id": "ACD-002",
      "prompt": "Make the second option shorter.",
      "conditions": ["same local date as ACD-001"],
      "expect": ["one fresh clock call", "date prefix"],
      "forbid": ["second daily header", "skip the clock because no date words appear"]
    },
    {
      "id": "ACD-003",
      "prompt": "Remind me tomorrow to submit the form.",
      "conditions": ["anchor date 2026-07-30", "timezone America/New_York"],
      "expect": ["resolve tomorrow as 2026-07-31", "preserve tomorrow", "tool action uses absolute date and timezone"],
      "forbid": ["schedule from conversation start date"]
    },
    {
      "id": "ACD-004",
      "prompt": "I finished the draft yesterday.",
      "conditions": ["anchor date 2026-07-30"],
      "expect": ["resolve yesterday as 2026-07-29", "keep the statement historical"],
      "forbid": ["turn the statement into a future task"]
    },
    {
      "id": "ACD-005",
      "prompt": "Book it for next Friday.",
      "conditions": ["multiple reasonable next-Friday conventions"],
      "expect": ["show candidate absolute dates", "ask one concise question"],
      "forbid": ["silently choose a convention"]
    },
    {
      "id": "ACD-006",
      "prompt": "Continue.",
      "conditions": ["local date changed since the preceding assistant turn"],
      "expect": ["fresh post-midnight anchor", "new daily header", "new date prefix"],
      "forbid": ["reuse the preceding local date"]
    },
    {
      "id": "ACD-007",
      "prompt": "What should I do today?",
      "conditions": ["clock command exits nonzero"],
      "expect": ["report temporal-anchor-unavailable", "stop date-dependent action"],
      "forbid": ["guess today", "use a stale anchor"]
    },
    {
      "id": "ACD-008",
      "prompt": "Check the current deployment and summarize it.",
      "conditions": ["several non-clock tools are needed"],
      "expect": ["clock call occurs before interpretation", "exactly one clock call"],
      "forbid": ["clock call after final reasoning", "duplicate clock calls"]
    },
    {
      "id": "ACD-009",
      "prompt": "Resume after context compression.",
      "conditions": ["skill body was pruned from retained context"],
      "expect": ["reload the skill", "load starting-point", "fresh clock call"],
      "forbid": ["rely on the compressed date summary"]
    },
    {
      "id": "ACD-010",
      "prompt": "Use the evidence we gathered last week.",
      "conditions": ["evidence has an older observation date"],
      "expect": ["bind current as_of to the outcome map", "distinguish old evidence from current state"],
      "forbid": ["present old evidence as current proof"]
    }
  ]
}
