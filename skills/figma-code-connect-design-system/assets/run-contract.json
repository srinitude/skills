    "id",
    "screen",
    "product_state",
    "form_factor",
    "viewport",
    "orientation",
    "input_path"
  ],
  "render_proof_fields": [
    "id",
    "status",
    "figma_evidence",
    "code_evidence",
    "mapping_evidence",
    "vision_evidence"
  ],
  "orientation_values": ["portrait", "landscape", "not_applicable"],
  "paired_orientation_form_factors": ["mobile", "tablet"],
  "property_comparison_link_field": "comparison_id",
  "figma_app_pass_gate": {
    "computer_control_capability": "platform-neutral local application control",
    "vision_owner": "same invoking strong vision-capable executor",
    "missing_capability_disposition": "blocked",
    "required_skills": [
      "dtcg-tokens",
      "design-like-im-5",
      "figma-code-connect-design-system",
      "computer-use"
    ],
    "required_sources": [
      "current direct vision",
      "current web research",
      "Mobbin",
      "Refero",
      "Lazyweb",
      "project-owned inspiration source",
      "product API specification",
      "event or webhook specification",
      "runtime primitive documentation"
    ],
    "required_item_kinds": ["page", "primitive", "component", "node", "layer"],
    "required_evidence_fields": [
      "whole_canvas_before",
      "whole_canvas_after",
      "active_area_before",
      "active_area_after",
      "cleanliness_receipt"
    ]
  },
  "nested_governance_required": true,
  "mutation_effects": [
    "repository_write",
    "figma_write",
    "metadata_publish",
    "metadata_unpublish",
    "delete"
