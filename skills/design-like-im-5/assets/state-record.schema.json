{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-record.schema.json",
  "title": "Open product state check",
  "type": "object",
  "required": [
    "action",
    "decision",
    "quality_gate",
    "open_world",
    "exhaustive",
    "state_items",
    "options",
    "chosen_direction",
    "unknowns",
    "evidence",
    "reason",
    "counterevidence",
    "uncertainty",
    "affected",
    "context_acknowledgements",
    "missing_context"
  ],
  "properties": {
    "action": { "const": "state_judgment" },
    "decision": { "enum": ["PASS", "REVISE", "BLOCKED"] },
    "open_world": { "const": true },
    "exhaustive": { "const": false },
    "state_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "context",
          "causes",
          "transitions",
          "model_reviews",
          "negative_reviews",
          "best_response",
          "alternatives",
          "evidence",
          "uncertainty"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "context": { "type": "object", "minProperties": 1 },
          "causes": { "type": "array", "minItems": 1 },
          "transitions": { "type": "array", "minItems": 1 },
          "model_reviews": {
            "type": "object",
            "required": ["eye", "brain", "touch"],
            "properties": {
              "eye": {
                "type": "array",
                "minItems": 10,
                "items": { "$ref": "#/$defs/checkAnswer" }
              },
              "brain": {
                "type": "array",
                "minItems": 10,
                "items": { "$ref": "#/$defs/checkAnswer" }
              },
              "touch": {
                "type": "array",
                "minItems": 10,
                "items": { "$ref": "#/$defs/checkAnswer" }
              }
            },
            "additionalProperties": true
          },
          "negative_reviews": {
            "$ref": "#/$defs/negativeReviews"
          },
          "best_response": { "type": "object", "minProperties": 1 },
          "alternatives": { "type": "array", "minItems": 1 },
          "evidence": { "type": "array", "minItems": 1 },
          "uncertainty": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "unknowns": { "type": "array" },
    "evidence": { "type": "array", "minItems": 1 },
    "reason": { "type": "string" },
    "counterevidence": { "type": "array" },
    "uncertainty": { "type": "string" },
    "affected": { "type": "array" },
    "context_acknowledgements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_context": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/option" }
    },
    "chosen_direction": { "$ref": "#/$defs/chosenDirection" }
  },
  "$defs": {
    "negativeReviews": {
      "type": "object",
      "required": ["objective_failure", "bad_design", "bad_output", "bad_practice"],
      "properties": {
        "objective_failure": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "bad_design": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "bad_output": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "bad_practice": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        }
      },
      "additionalProperties": true
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "scene",
        "hypothesis",
        "product_fit",
        "evidence",
        "tradeoffs",
        "veto_check",
        "test",
        "novelty"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "scene": { "type": "string", "minLength": 1 },
        "hypothesis": { "type": "string", "minLength": 1 },
        "product_fit": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1 },
        "tradeoffs": { "type": "array", "minItems": 1 },
        "veto_check": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "novelty": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "chosenDirection": {
      "type": "object",
      "required": ["source_option_ids", "reason"],
      "properties": {
        "source_option_ids": { "type": "array", "minItems": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "checkAnswer": {
      "type": "object",
      "required": [
        "id",
        "scene",
        "observation",
        "evidence",
        "decision",
        "reason",
        "alternatives",
        "uncertainty"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scene": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1 },
        "decision": {
          "enum": ["PASS", "REVISE", "BLOCKED", "NOT_APPLICABLE"]
        },
        "quality_gate": {
          "type": "object",
          "required": ["checkpoint", "status", "diagnosis", "gates"],
          "properties": {
            "checkpoint": { "const": "direction" },
            "status": { "enum": ["PASS", "REVISE", "BLOCKED"] },
            "diagnosis": { "enum": ["DEFECT", "MEDIOCRE", "SLOP", "PASS"] },
            "gates": { "type": "array", "minItems": 9, "maxItems": 9 }
          },
          "additionalProperties": true
        },
        "reason": { "type": "string", "minLength": 1 },
        "alternatives": { "type": "array", "minItems": 1 },
        "uncertainty": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
