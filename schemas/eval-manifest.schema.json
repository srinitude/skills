{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/srinitude/skills/main/schemas/eval-manifest.schema.json",
  "title": "Agent Skill evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "test_classes",
    "conditions",
    "repetitions",
    "case_source",
    "trigger_source",
    "contract",
    "rubric",
    "speed_budgets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "test_classes": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "allOf": [
        { "contains": { "const": "positive_activation" } },
        { "contains": { "const": "rejection" } },
        { "contains": { "const": "behavior" } },
        { "contains": { "const": "failure_handling" } },
        { "contains": { "const": "recovery" } },
        { "contains": { "const": "speed" } }
      ]
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [{ "const": "with_skill" }, { "const": "without_skill" }]
    },
    "repetitions": { "type": "integer", "const": 2 },
    "case_source": { "const": "cases.json" },
    "trigger_source": { "const": "trigger-cases.json" },
    "contract": { "const": "contract.md" },
    "rubric": { "const": "rubric.md" },
    "speed_budgets": { "const": "speed-budgets.json" },
    "public_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "centrality_mapping": { "const": "centrality-mapping.json" },
    "video_learning_map": { "const": "video-learning-map.json" },
    "video_second_map": { "const": "video-second-map.json" }
  }
}
