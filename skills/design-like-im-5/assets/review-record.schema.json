{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-record.schema.json",
  "title": "Model eye, brain, and touch review",
  "type": "object",
  "required": [
    "action",
    "decision",
    "model_reviews",
    "negative_reviews",
    "quality_gate",
    "evidence",
    "reason",
    "counterevidence",
    "uncertainty",
    "affected",
    "context_acknowledgements",
    "missing_context"
  ],
  "properties": {
    "action": { "const": "visual_review" },
    "decision": { "enum": ["PASS", "REVISE", "BLOCKED"] },
    "model_reviews": {
      "type": "object",
      "required": ["eye", "brain", "touch"],
      "properties": {
        "eye": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "brain": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "touch": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        }
      },
      "additionalProperties": true
    },
    "negative_reviews": {
      "$ref": "#/$defs/negativeReviews"
    },
    "quality_gate": { "$ref": "#/$defs/qualityGate" },
    "evidence": { "type": "array", "minItems": 1 },
    "reason": { "type": "string" },
    "counterevidence": { "type": "array" },
    "uncertainty": { "type": "string" },
    "affected": { "type": "array" },
    "context_acknowledgements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_context": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "qualityGate": {
      "type": "object",
      "required": ["checkpoint", "status", "diagnosis", "gates"],
      "properties": {
        "checkpoint": { "const": "integrated" },
        "status": { "enum": ["PASS", "REVISE", "BLOCKED"] },
        "diagnosis": { "enum": ["DEFECT", "MEDIOCRE", "SLOP", "PASS"] },
        "gates": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": ["id", "status", "evidence"],
            "properties": {
              "id": {
                "enum": [
                  "truth",
                  "access",
                  "task",
                  "perception",
                  "familiarity",
                  "standards",
                  "uniqueness",
                  "craft",
                  "resilience"
                ]
              },
              "status": { "enum": ["PASS", "REVISE", "BLOCKED"] },
              "evidence": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "negativeReviews": {
      "type": "object",
      "required": ["objective_failure", "bad_design", "bad_output", "bad_practice"],
      "properties": {
        "objective_failure": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "bad_design": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "bad_output": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        },
        "bad_practice": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/checkAnswer" }
        }
      },
      "additionalProperties": true
    },
    "checkAnswer": {
      "type": "object",
      "required": [
        "id",
        "scene",
        "observation",
        "evidence",
        "decision",
        "reason",
        "alternatives",
        "uncertainty"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scene": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1 },
        "decision": {
          "enum": ["PASS", "REVISE", "BLOCKED", "NOT_APPLICABLE"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "alternatives": { "type": "array", "minItems": 1 },
        "uncertainty": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
