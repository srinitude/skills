      "primary_output": "statement.register",
      "decision_owner": "agent",
      "support_files": [
        "references/evidence-schema.md",
        "references/decisions.md",
        "scripts/run_pipeline.py"
      ]
    },
    {
      "id": "S06",
      "consumes": ["statement.register", "observation.register"],
